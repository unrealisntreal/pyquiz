Screen {
    padding: 1 4;
}

Rule {
    color: rgba(100, 100, 100, 0.45);
}

Horizontal.row {
    align: center middle;
}

Input, Input:focus {
    background: rgba(255, 255, 255, 0);
    border: round rgba(255, 255, 255, 0.45);
}

Button, Button:focus {
    background: rgba(255, 255, 255, 0);
    text-style: none;
    border: round rgba(255, 255, 255, 0.45);
}

Button:hover {
   background: rgba(255, 255, 255, 0);
   text-style: none;
   border: round rgba(255, 255, 255, 0.75);
}
