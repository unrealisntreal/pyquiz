#mainmenu-row {
    align: center middle;
}

#negative-marking {
    border: none;
}

Screen {
    padding: 1 4;
}

Rule {
    color: rgba(100, 100, 100, 0.45);
}

Input, Input:focus {
    background: transparent;
    border: round rgba(255, 255, 255, 0.45);
}

Button, Button:focus {
    background: transparent;
    text-style: none;
    border: round rgba(255, 255, 255, 0.45);
}

Button:hover {
   background: transparent;
   text-style: none;
   border: round rgba(255, 255, 255, 0.75);
}
