Screen {
    padding: 1 4;
}

Tooltip {
    background: rgba(255, 255, 255, 1);
}

Toast {
    background: rgba(255, 255, 255, 1);
}

Horizontal {
    align: center middle;
}

Static.art {
    content-align: center middle;
}

Button, Button:focus {
    background: rgba(255, 255, 255, 0);
    text-style: none;
    border: round rgba(255, 255, 255, 0.45);
}

Button:hover {
   background: rgba(255, 255, 255, 0);
   text-style: none;
   border: round rgba(255, 255, 255, 0.75);
}

#github, #github:focus {
   background: rgba(255, 255, 255, 0);
   text-style: none;
   border: round rgba(100, 100, 100, 0.45);
}

#github:hover {
   background: rgba(255, 255, 255, 0);
   text-style: none;
   border: round rgba(100, 100, 100, 0.75);
}